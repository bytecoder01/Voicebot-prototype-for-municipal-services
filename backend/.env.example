# Copy this file to .env and fill in your values

# Server port (default: 3000)
PORT=3000

# Public URL for Vapi tools (ngrok/localtunnel)
# Example: https://abcd-1234.ngrok-free.app
PUBLIC_URL=https://YOUR_PUBLIC_URL

# ── Persistence (optional) ─────────────────────────────────────────────────────
# Uncomment to save appointments to a JSON file (survives server restarts)
# Without this, appointments live in memory only (fine for the demo/test)
# DATABASE_PATH=./appointments.json

# ── Gemini Embeddings (optional upgrade) ──────────────────────────────────────
# By default the backend uses fast keyword search (no API key needed).
# To upgrade to semantic search with Google's gemini-embedding-001 model:
#   1. Get a free API key at aistudio.google.com
#   2. npm install @google/generative-ai
#   3. Uncomment the two lines below
# USE_EMBEDDINGS=true
# GEMINI_API_KEY=your_key_here

VAPI_PRIVATE_KEY=your_key_here
